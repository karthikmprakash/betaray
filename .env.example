DATABASE_URL="file:./dev.db"
# Enable only when developing locally. This route is disabled in production.
ALLOW_LOCAL_DEMO="false"
# Set the canonical origin for production requests.
# APP_URL="https://qa.example.com"
# Optional: both values are required for live AI generation.
# OPENAI_API_KEY=""
# OPENAI_MODEL=""

# Jira Cloud OAuth 2.0 (3LO)
# Create an OAuth app at https://developer.atlassian.com/console/myapps/
# Callback URL must match JIRA_REDIRECT_URI exactly.
JIRA_CLIENT_ID=""
JIRA_CLIENT_SECRET=""
JIRA_REDIRECT_URI=""
# 32+ byte random string used to encrypt OAuth credentials at rest.
JIRA_TOKEN_KEY=""
